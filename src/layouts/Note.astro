---
// Layout for a single market note. Markdown files in src/pages/notes/ point here with `layout:`.
import Base from './Base.astro';
const { frontmatter } = Astro.props;
const date = new Date(frontmatter.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={`${frontmatter.title} · Zaahid Tinwala`} description={frontmatter.summary} root="../" active="note">
  <article class="wrap">
    <div class="note">
      <a class="back mono" href="../notes.html">← NOTE &lt;GO&gt; All notes</a>
      <p class="meta mono">{date} · {frontmatter.tag}</p>
      <h1 class="display">{frontmatter.title}</h1>
      <p class="standfirst">{frontmatter.summary}</p>
      <div class="prose"><slot /></div>
    </div>
  </article>
</Base>

<style>
  .note { max-width: 46rem; padding-block: 3rem 0; }
  .back { font-size: 0.78rem; }
  .meta { color: var(--muted); font-size: 0.78rem; margin: 2rem 0 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; }
  h1 { font-weight: 700; font-size: clamp(2.2rem, 6vw, 3.4rem); line-height: 0.98; margin: 0 0 1rem; text-wrap: balance; }
  .standfirst { font-size: 1.15rem; color: var(--muted); margin: 0 0 2.5rem; padding-bottom: 2rem; border-bottom: 1px solid var(--line); }
  .prose :global(h2) { font-family: var(--font-display); font-variation-settings: 'wdth' 85, 'opsz' 48; font-weight: 700; font-size: 1.5rem; margin: 2.5rem 0 0.75rem; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.2rem; display: grid; gap: 0.5rem; }
  .prose :global(li::marker) { color: var(--amber); }
  .prose :global(strong) { font-weight: 600; }
  .prose :global(blockquote) { margin: 2rem 0; padding: 1rem 1.25rem; border-left: 2px solid var(--amber); background: var(--panel); }
  .prose :global(blockquote p) { margin: 0; }
  .prose :global(table) { width: 100%; border-collapse: collapse; font-size: 0.92rem; margin: 1.5rem 0; display: block; overflow-x: auto; }
  .prose :global(th), .prose :global(td) { text-align: left; padding: 0.6rem 0.75rem 0.6rem 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .prose :global(th) { font: 500 0.72rem var(--font-mono); text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
</style>
